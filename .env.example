# Razorpay Test Mode only. Never commit real keys.
# Dashboard → Test Mode → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail SMTP for reminder emails. Use an App Password, not your login password.
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Required for the public /api/webhooks/razorpay route.
# On localhost, mark the link paid from the lab instead.
RAZORPAY_WEBHOOK_SECRET=
